<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CleanRoom.Samples.Analytics</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Resolved from ./nupkgs (see nuget.config). -->
    <!-- Dataplane SDK (frontend service). -->
    <PackageReference Include="Azure.CleanRoom.Analytics" Version="1.0.0-beta.1" />
    <!-- Management-plane (ARM) SDK; replaces `az rest` / Azure CLI calls. -->
    <PackageReference Include="Azure.ResourceManager.CleanRoom" Version="1.0.0-beta.1" />
    <!--
      Azure.Core 1.56 (pulled in by the ARM SDK) now ships identity types
      directly (DefaultAzureCredential, AuthenticationFailedException), but
      Azure.Identity 1.17.1 (pulled in transitively by the dataplane SDK)
      still has its own implementations - CS0433 clashes result.
      Pin Azure.Identity here with an extern alias so the global namespace
      only sees Azure.Core's copies.
    -->
    <PackageReference Include="Azure.Identity" Version="1.17.1" Aliases="AzId" />
  </ItemGroup>
</Project>
